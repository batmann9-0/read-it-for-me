# --- Vision model: any OpenAI-compatible chat-completions endpoint ---
# Qwen on DashScope:
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
API_KEY=your-api-key-here
MODEL=qwen2.5-vl-72b-instruct
# Other options:
#   Hugging Face / vLLM / Ollama: set BASE_URL to that server's /v1 URL.
#   Gemini OpenAI-compatible: BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#                             MODEL=gemini-3.5-flash  (API_KEY = your Gemini key)

# --- Optional Gemini bridge (hosted demo; key stays in the bridge) ---
# VISION_BRIDGE_URL=https://your-tunnel.example/webhook/readit-analyze
# VISION_BRIDGE_TOKEN=change-me

DEFAULT_LANG=ur
